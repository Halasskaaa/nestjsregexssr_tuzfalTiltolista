<!DOCTYPE html>
<html lang="hun">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Profil szerkesztés
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <table>
        <thead>
            <tr>
                <th>Priority</th>
                <th>MAC</th>
                <th>Enabled</th>
            </tr>
        </thead>
        <tbody>
            <% rules.array.forEach(rule => { %>
                <tr><% rule.id %></tr>
                <tr><% rule.priority %></tr>
                <tr><% rule.mac %></tr>
                <tr><% rule.enabled %></tr>
            <% }); %>
        </tbody>
    </table>


</body>
</html>