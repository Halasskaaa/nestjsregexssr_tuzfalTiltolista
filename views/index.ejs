<!DOCTYPE html>
<html lang="hun">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Profil szerkesztés
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <form method="post">
            <h2>Új szabály</h2>
            <input type="number" name="priority" placeholder="priority" min="1" max="10">
            <input type="text" name="mac" placeholder="mac" pattern="[a-z.A-Z0-9]{2}:[a-z.A-Z0-9]{2}:[a-z.A-Z0-9]{2}:[a-z.A-Z0-9]{2}:[a-z.A-Z0-9]{2}:[a-z.A-Z0-9]{2}" required>

            <select name="enabled" id="enabled">
                <option value="0">❌</option>
                <option value="1">✅</option>
            </select>

            <button>Add</button>
        </form>

        <br>

        <table>
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>MAC</th>
                    <th>Enabled</th>
                </tr>
            </thead>
            <tbody>
                <% rules.forEach(rule=> { %>
                    <tr>
                        <td>
                            <%= rule.priority %>
                        </td>
                        <td>
                            <%= rule.mac %>
                        </td>
                        <td>
                            <%= rule.enabled %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>
</body>

</html>